# PostgreSQL konteynerinin ortamı -- YALNIZCA postgres servisi okur.
# Kopyala: cp postgres.env.example postgres.env  (postgres.env git'e girmez)
#
# Süper kullanıcı: yalnızca yönetim. Bot bu hesapla BAĞLANMAZ; botun
# hesabı .env'dedir (POSTGRES_USER=vasi_bot). Bu parola botun ve
# LiteLLM'in ortamında bulunmamalı.
# Parolayı üret: openssl rand -hex 24  (botunkinden FARKLI)
POSTGRES_USER=vasi
POSTGRES_PASSWORD=
POSTGRES_DB=vasi
