TELEGRAM_BOT_TOKEN=Buraya_BotFather_Tokenini_Yazin
MY_TELEGRAM_ID=Buraya_Kendi_IDnizi_Yazin
WORKSPACE_DIR=/app/workspace
# Mac/host uzerinde zaten calisan Ollama icin:
OLLAMA_HOST=http://host.docker.internal:11434
VASI_NOTES_FILE=notlar/NOTES.md
VASI_CHANNEL_STYLE_FILE=skills/youtube_icerik.md
VASI_CODE_STYLE_FILE=skills/kod_yardimcisi.md
VASI_MODEL_GATEKEEPER=qwen3:30b
VASI_MODEL_STRATEJI=qwen3:30b
VASI_MODEL_TEKNIK=qwen3:30b
VASI_MODEL_KOD=qwen3-coder:30b
VASI_MODEL_GORSEL=qwen3:30b
GEMINI_API_KEY=Buraya_Gemini_API_Key_Yazin
GEMINI_MODEL=gemini-2.5-flash
# Opsiyonel: Web radar'ı sadece belirli domainlerde çalıştırmak için
# WEB_RADAR_ALLOWLIST=github.com,openai.com,ai.google.dev
PENDING_ACTION_TTL_SECONDS=600
GEMINI_DAILY_LIMIT_REQUESTS=60
# Istege bagli: Ollama guvenligi icin API Key
# OLLAMA_API_KEY=your-secret-key-here

# ── PostgreSQL (kalıcı hafıza) ────────────────────────────────
# Parolayı üret: openssl rand -hex 24
# Boş bırakılırsa hafıza kapalı kalır, sistem çalışmaya devam eder.
POSTGRES_PASSWORD=
POSTGRES_HOST=postgres
POSTGRES_DB=vasi
POSTGRES_USER=vasi

# ── Konuşma geçmişi ───────────────────────────────────────────
# Kaç tur saklanır (bir tur = kullanıcı mesajı + model cevabı)
MAX_HISTORY_TURNS=10

# ── Hafıza prompt sınırları ───────────────────────────────────
MEMORY_PROMPT_LIMIT=20
MEMORY_PROMPT_CHARS=2000


# ── Log rotasyonu ─────────────────────────────────────────────────────────────
# Dosya bu boyuta ulaşınca döner. Varsayılan 10 MB x 5 dosya = en fazla 50 MB.
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# Denetim kayıtları için ayrı dosya. Genel logdan da silinmez;
# bu EK bir kopyadır ve daha uzun süre saklanabilir.
AUDIT_LOG_FILE=/tmp/vasi_audit.log

# ── Oran limitleri ────────────────────────────────────────────────────────────
# Varsayılanlar tek operatörlü bir sistem için seçildi.
# Paylaşımlı kullanımda düşürün.
RATE_LIMIT_WINDOW=60
RATE_LIMIT_REQUESTS=20
GEMINI_RATE_LIMIT_REQUESTS=5

# ── RAG ──
RAG_EMBED_MODEL=bge-m3
RAG_EMBED_TIMEOUT=120
RAG_CHUNK_MAX_CHARS=1200
RAG_SEARCH_TOP_K=5
RAG_MIN_SCORE=0.50
